# /etc/desyp/notification.env (chmod 600, owner root). 값은 저장소에 커밋하지 않는다.
DB_URL=jdbc:postgresql://localhost:5432/desyp
DB_USERNAME=desyp
DB_PASSWORD=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://api.desyp.site/auth/naver/callback
FRONTEND_ORIGIN=https://www.desyp.site
ADMIN_NAVER_ACCOUNT_IDS=
# /admin.html 대시보드 로그인. 비어 있으면 대시보드 접근을 모두 거부한다. 추측하기 어려운 긴 비밀번호를 쓴다.
ADMIN_DASHBOARD_USERNAME=
ADMIN_DASHBOARD_PASSWORD=
SES_SENDER_EMAIL=
AWS_REGION=ap-northeast-2
# SES 권한은 액세스 키 대신 EC2 인스턴스 IAM 역할로 준다.
